# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (SQLite by default — no setup required)
DATABASE_URL=sqlite:///./data/rss_generator.db

# Feed defaults
DEFAULT_POLL_INTERVAL_MINUTES=60
MAX_ITEMS_PER_FEED=50

# HTTP scraping
REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=Mozilla/5.0 (compatible; RSSGenerator/1.0)

# Set to true to enable Playwright for JS-rendered pages (requires: playwright install chromium)
PLAYWRIGHT_ENABLED=false

# Public base URL used when serving feeds to external readers (e.g. Readwise/Feedly)
# Set this to your ngrok/cloudflare tunnel URL for local dev
PUBLIC_BASE_URL=http://localhost:8000
